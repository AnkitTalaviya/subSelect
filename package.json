{
  "name": "subselect",
  "version": "0.1.0",
  "private": true,
  "description": "SubSelect — make subtitles on online videos clickable, selectable and useful.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run clean && npm run icons && node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "dev": "npm run icons && node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "verify:browser": "node scripts/verify-browser.mjs",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
