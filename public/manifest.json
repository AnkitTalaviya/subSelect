{
  "manifest_version": 3,
  "name": "SubSelect — Interactive Subtitles",
  "short_name": "SubSelect",
  "version": "0.1.0",
  "description": "Click or select words in video subtitles to look them up, copy them and save them while you watch.",
  "minimum_chrome_version": "109",

  "permissions": ["storage", "scripting", "activeTab"],

  "optional_host_permissions": ["*://*/*"],

  "background": {
    "service_worker": "service-worker.js"
  },

  "content_scripts": [
    {
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.netflix.com/*",
        "*://*.primevideo.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hotstar.com/*",
        "*://*.jiohotstar.com/*",
        "*://*.twitch.tv/*",
        "*://*.vimeo.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.max.com/*",
        "*://tv.apple.com/*",
        "*://*.plex.tv/*",
        "file:///*"
      ]
    }
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "commands": {
    "toggle-interactive-subtitles": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Turn interactive subtitles on or off"
    }
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "SubSelect",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
